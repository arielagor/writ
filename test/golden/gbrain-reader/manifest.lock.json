{
  "policy_version": "59edfcb44d87d8bbcf9d8786fd7eab8c28366ad9c4b22cfa9b43d50be170e24c",
  "manifest": {
    "agent_id": "gbrain-reader",
    "allowed_tools": [
      {
        "constraints": {
          "arg_allow": {
            "limit": "^([1-9]|[1-4][0-9]|50)$"
          }
        },
        "name": "mcp__gbrain__query"
      },
      {
        "name": "mcp__gbrain__search"
      },
      {
        "constraints": {
          "arg_deny": {
            "slug": "^(secrets|credentials)/"
          }
        },
        "name": "mcp__gbrain__get_page"
      }
    ],
    "credential_ttl_seconds": 600,
    "data_classes": [
      "personal-notes",
      "contacts"
    ],
    "deny_by_default": true,
    "escalation_contact": "ariel@agor.me",
    "expires_at": "2026-12-31T23:59:59Z",
    "owner": {
      "email": "ariel@agor.me",
      "name": "Ariel Agor"
    },
    "purpose": "Read-only research against the personal knowledge brain: semantic query, keyword search, and fetching a page by slug. It never writes a page, never adds a link or a tag, and never touches the filesystem or the shell.",
    "purpose_id": "gbrain-read-only"
  }
}
