{
  "permissions": {
    "allow": [
      "Write(/workspace/blog/posts/**)",
      "Edit(/workspace/blog/posts/**)",
      "mcp__gbrain__query"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/remit-gate.mjs --manifest \"examples/blog-publisher.yaml\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
